{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vina Desktop Widget",
  "version": "0.1.0",
  "identifier": "com.vina.desktopwidget",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "floating",
        "title": "Vina",
        "url": "index.html#/floating",
        "width": 260,
        "height": 260,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": true
      },
      {
        "label": "liuyao",
        "title": "天道六爻",
        "url": "index.html#/liuyao",
        "width": 920,
        "height": 650,
        "decorations": false,
        "transparent": false,
        "resizable": true,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
